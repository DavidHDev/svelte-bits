			"content": "<script module lang=\"ts\">\n\timport { gsap } from 'gsap';\n\n\tinterface TrailConfig {\n\t\tthreshold: number;\n\t\tlifetime: number;\n\t\tappearScale: number;\n\t\tzoom: number;\n\t\tflash: number;\n\t\texitScale: number;\n\t\tdrift: number;\n\t\trotation: number;\n\t\tsizeVariance: number;\n\t\talignToMotion: boolean;\n\t\tstack: number;\n\t\ttilt: number;\n\t}\n\n\tinterface TrailImage {\n\t\tel: HTMLElement;\n\t\tinner: HTMLElement;\n\t}\n\n\tconst lerp = (a: number, b: number, n: number) => (1 - n) * a + n * b;\n\n\tconst toCssLength = (value: number | string) => (typeof value === 'number' ? `${value}px` : value);\n\n\tconst createTrail = (container: HTMLDivElement, config: { readonly current: TrailConfig }) => {\n\t\tconst images: TrailImage[] = Array.from(container.querySelectorAll<HTMLElement>('[data-trail-image]')).map(\n\t\t\t(el) => ({\n\t\t\t\tel,\n\t\t\t\tinner: el.firstElementChild as HTMLElement\n\t\t\t})\n\t\t);\n\t\tconst total = images.length;\n\t\tconst query =\n\t\t\ttypeof window.matchMedia === 'function' ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;\n\t\tconst mouse = { x: 0, y: 0 };\n\t\tconst last = { x: 0, y: 0 };\n\t\tconst cache = { x: 0, y: 0 };\n\t\tconst visible: TrailImage[] = [];\n\t\tlet started = false;\n\t\tlet raf = 0;\n\t\tlet index = -1;\n\t\tlet zIndex = 1;\n\t\tlet active = 0;\n\t\tlet lastAngle = 0;\n\t\tlet destroyed = false;\n\n\t\tconst settle = () => {\n\t\t\tactive = Math.max(0, active - 1);\n\t\t\tif (!active && !visible.length) zIndex = 1;\n\t\t};\n\n\t\tconst retire = (img: TrailImage) => {\n\t\t\tconst cfg = config.current;\n\t\t\tgsap.to(img.el, {\n\t\t\t\tduration: 0.4,\n\t\t\t\tease: 'power4',\n\t\t\t\topacity: 0,\n\t\t\t\tscale: cfg.exitScale,\n\t\t\t\tonComplete: () => {\n\t\t\t\t\tif (!active && !visible.length) zIndex = 1;\n\t\t\t\t}\n\t\t\t});\n\t\t};\n\n\t\tconst spawn = () => {\n\t\t\tconst cfg = config.current;\n\t\t\tif (!total) return;\n\t\t\tindex = (index + 1) % total;\n\t\t\tconst img = images[index];\n\t\t\tconst width = img.el.offsetWidth;\n\t\t\tconst height = img.el.offsetHeight;\n\t\t\tconst dx = mouse.x - last.x;\n\t\t\tconst dy = mouse.y - last.y;\n\t\t\tconst angle = (Math.atan2(dy, dx) * 180) / Math.PI;\n\t\t\tlet fromAngle = gsap.utils.random(-cfg.rotation, cfg.rotation);\n\t\t\tlet toAngle = fromAngle * 0.4;\n\t\t\tif (cfg.alignToMotion) {\n\t\t\t\tfromAngle = lastAngle;\n\t\t\t\ttoAngle = angle;\n\t\t\t\twhile (toAngle - fromAngle > 180) toAngle -= 360;\n\t\t\t\twhile (toAngle - fromAngle < -180) toAngle += 360;\n\t\t\t\tlastAngle = toAngle;\n\t\t\t}\n\t\t\tconst scale = 1 + gsap.utils.random(-0.5, 0.6) * cfg.sizeVariance;\n\t\t\tconst box = container.getBoundingClientRect();\n\t\t\tconst tiltX = box.height ? -((mouse.y - box.height / 2) / (box.height / 2)) * cfg.tilt : 0;\n\t\t\tconst tiltY = box.width ? ((mouse.x - box.width / 2) / (box.width / 2)) * cfg.tilt : 0;\n\t\t\tconst drift = cfg.drift > 0;\n\t\t\tconst slide = drift ? 0.6 * cfg.drift : 0;\n\n\t\t\t++zIndex;\n\t\t\t++active;\n\t\t\tgsap.killTweensOf(img.el);\n\t\t\tgsap.killTweensOf(img.inner);\n\t\t\tconst visibleIndex = visible.indexOf(img);\n\t\t\tif (visibleIndex >= 0) visible.splice(visibleIndex, 1);\n\n\t\t\tconst timeline = gsap.timeline({ onComplete: settle });\n\t\t\ttimeline.fromTo(\n\t\t\t\timg.el,\n\t\t\t\t{\n\t\t\t\t\topacity: 1,\n\t\t\t\t\tscale: cfg.appearScale * scale,\n\t\t\t\t\tzIndex,\n\t\t\t\t\tx: cache.x - width / 2,\n\t\t\t\t\ty: cache.y - height / 2,\n\t\t\t\t\trotation: fromAngle,\n\t\t\t\t\trotationX: tiltX * 0.5,\n\t\t\t\t\trotationY: tiltY * 0.5\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\tduration: drift ? 0.9 : 0.4,\n\t\t\t\t\tease: drift ? 'power2' : 'power1',\n\t\t\t\t\tscale,\n\t\t\t\t\tx: mouse.x - width / 2 + dx * slide,\n\t\t\t\t\ty: mouse.y - height / 2 + dy * slide,\n\t\t\t\t\trotation: toAngle,\n\t\t\t\t\trotationX: tiltX,\n\t\t\t\t\trotationY: tiltY\n\t\t\t\t},\n\t\t\t\t0\n\t\t\t);\n\t\t\tif (cfg.zoom !== 1 || cfg.flash > 0) {\n\t\t\t\ttimeline.fromTo(\n\t\t\t\t\timg.inner,\n\t\t\t\t\t{ scale: cfg.zoom, filter: `brightness(${1 + cfg.flash * 1.5})` },\n\t\t\t\t\t{ duration: 0.5, ease: 'power1', scale: 1, filter: 'brightness(1)' },\n\t\t\t\t\t0\n\t\t\t\t);\n\t\t\t}\n\n\t\t\tif (cfg.stack > 0) {\n\t\t\t\tvisible.push(img);\n\t\t\t\tconst keep = Math.max(1, Math.min(Math.round(cfg.stack), total - 1));\n\t\t\t\twhile (visible.length > keep) {\n\t\t\t\t\tconst old = visible.shift();\n\t\t\t\t\tif (old) retire(old);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\ttimeline.to(\n\t\t\t\timg.el,\n\t\t\t\t{\n\t\t\t\t\tduration: 0.4,\n\t\t\t\t\tease: drift ? 'expo' : 'power3',\n\t\t\t\t\topacity: 0,\n\t\t\t\t\tscale: cfg.exitScale * scale\n\t\t\t\t},\n\t\t\t\tcfg.lifetime\n\t\t\t);\n\t\t\tif (drift) {\n\t\t\t\ttimeline.to(\n\t\t\t\t\timg.el,\n\t\t\t\t\t{\n\t\t\t\t\t\tduration: 1.5,\n\t\t\t\t\t\tease: 'power4',\n\t\t\t\t\t\tx: `+=${dx * cfg.drift * 1.2}`,\n\t\t\t\t\t\ty: `+=${dy * cfg.drift * 1.2}`\n\t\t\t\t\t},\n\t\t\t\t\tcfg.lifetime\n\t\t\t\t);\n\t\t\t}\n\t\t};\n\n\t\tconst loop = () => {\n\t\t\traf = 0;\n\t\t\tif (destroyed) return;\n\t\t\tconst cfg = config.current;\n\t\t\tcache.x = lerp(cache.x, mouse.x, 0.1);\n\t\t\tcache.y = lerp(cache.y, mouse.y, 0.1);\n\t\t\tif (!query?.matches && Math.hypot(mouse.x - last.x, mouse.y - last.y) > cfg.threshold) {\n\t\t\t\tspawn();\n\t\t\t\tlast.x = mouse.x;\n\t\t\t\tlast.y = mouse.y;\n\t\t\t}\n\t\t\tif (Math.abs(cache.x - mouse.x) > 0.5 || Math.abs(cache.y - mouse.y) > 0.5) {\n\t\t\t\traf = requestAnimationFrame(loop);\n\t\t\t}\n\t\t};\n\n\t\tconst onMove = (e: MouseEvent | TouchEvent) => {\n\t\t\tconst rect = container.getBoundingClientRect();\n\t\t\tconst point = 'touches' in e ? e.touches[0] : e;\n\t\t\tif (!point) return;\n\t\t\tmouse.x = point.clientX - rect.left;\n\t\t\tmouse.y = point.clientY - rect.top;\n\t\t\tif (!started) {\n\t\t\t\tstarted = true;\n\t\t\t\tcache.x = last.x = mouse.x;\n\t\t\t\tcache.y = last.y = mouse.y;\n\t\t\t}\n\t\t\tif (!raf) raf = requestAnimationFrame(loop);\n\t\t};\n\n\t\tcontainer.addEventListener('mousemove', onMove);\n\t\tcontainer.addEventListener('touchmove', onMove, { passive: true });\n\n\t\treturn () => {\n\t\t\tdestroyed = true;\n\t\t\tif (raf) cancelAnimationFrame(raf);\n\t\t\tcontainer.removeEventListener('mousemove', onMove);\n\t\t\tcontainer.removeEventListener('touchmove', onMove);\n\t\t\timages.forEach((img) => {\n\t\t\t\tgsap.killTweensOf(img.el);\n\t\t\t\tgsap.killTweensOf(img.inner);\n\t\t\t});\n\t\t};\n\t};\n</script>\n\n<script lang=\"ts\">\n\tinterface ImageTrailProps {\n\t\titems?: string[];\n\t\tsize?: number | string;\n\t\taspectRatio?: number;\n\t\tradius?: number | string;\n\t\tthreshold?: number;\n\t\tlifetime?: number;\n\t\tappearScale?: number;\n\t\tzoom?: number;\n\t\tflash?: number;\n\t\texitScale?: number;\n\t\tdrift?: number;\n\t\trotation?: number;\n\t\tsizeVariance?: number;\n\t\talignToMotion?: boolean;\n\t\tstack?: number;\n\t\ttilt?: number;\n\t\tclass?: string;\n\t}\n\n\tlet {\n\t\titems = [],\n\t\tsize = 190,\n\t\taspectRatio = 1.1,\n\t\tradius = 15,\n\t\tthreshold = 80,\n\t\tlifetime = 0.4,\n\t\tappearScale = 1,\n\t\tzoom = 1,\n\t\tflash = 0,\n\t\texitScale = 0.2,\n\t\tdrift = 0,\n\t\trotation = 0,\n\t\tsizeVariance = 0,\n\t\talignToMotion = false,\n\t\tstack = 0,\n\t\ttilt = 0,\n\t\tclass: className = ''\n\t}: ImageTrailProps = $props();\n\n\tlet containerEl = $state<HTMLDivElement | null>(null);\n\n\tconst config = {\n\t\tget current(): TrailConfig {\n\t\t\treturn {\n\t\t\t\tthreshold,\n\t\t\t\tlifetime,\n\t\t\t\tappearScale,\n\t\t\t\tzoom,\n\t\t\t\tflash,\n\t\t\t\texitScale,\n\t\t\t\tdrift,\n\t\t\t\trotation,\n\t\t\t\tsizeVariance,\n\t\t\t\talignToMotion,\n\t\t\t\tstack,\n\t\t\t\ttilt\n\t\t\t};\n\t\t}\n\t};\n\n\t$effect(() => {\n\t\tvoid items;\n\t\tif (!containerEl) return;\n\t\treturn createTrail(containerEl, config);\n\t});\n</script>\n\n<div\n\tbind:this={containerEl}\n\tclass={`relative z-[100] h-full w-full overflow-visible rounded-lg bg-transparent ${className}`.trim()}\n\tstyle:--trail-size={toCssLength(size)}\n\tstyle:--trail-aspect={String(aspectRatio)}\n\tstyle:--trail-radius={toCssLength(radius)}\n\tstyle:perspective={tilt ? '1000px' : undefined}\n>\n\t{#each items as url, i (i)}\n\t\t<div\n\t\t\tclass=\"pointer-events-none absolute top-0 left-0 aspect-[var(--trail-aspect)] w-[var(--trail-size)] overflow-hidden rounded-[var(--trail-radius)] opacity-0 [will-change:transform,filter]\"\n\t\t\tdata-trail-image=\"\"\n\t\t>\n\t\t\t<div\n\t\t\t\tclass=\"absolute top-[-10px] left-[-10px] h-[calc(100%+20px)] w-[calc(100%+20px)] bg-cover bg-center\"\n\t\t\t\tstyle:background-image=\"url({url})\"\n\t\t\t></div>\n\t\t</div>\n\t{/each}\n</div>\n"
		}
