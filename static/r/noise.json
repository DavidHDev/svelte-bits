\t\t\tif (raf || !alive || !visible) return;\n\t\t\traf = requestAnimationFrame(tick);\n\t\t};\n\t\twake = wakeLoop;\n\n\t\tconst resizeObserver = new ResizeObserver(resize);\n\t\tresizeObserver.observe(root);\n\t\tconst visibility = new IntersectionObserver((entries) => {\n\t\t\tvisible = entries.some((entry) => entry.isIntersecting);\n\t\t\tif (visible) wakeLoop();\n\t\t});\n\t\tvisibility.observe(root);\n\t\tresize();\n\t\twakeLoop();\n\n\t\treturn () => {\n\t\t\talive = false;\n\t\t\tcancelAnimationFrame(raf);\n\t\t\twake = null;\n\t\t\tresizeObserver.disconnect();\n\t\t\tvisibility.disconnect();\n\t\t\tif (url) URL.revokeObjectURL(url);\n\t\t\turl = '';\n\t\t};\n\t});\n</script>\n\n<div bind:this={rootEl} class={rootClass} style={rootStyle || undefined} aria-hidden=\"true\">\n\t<div\n\t\tbind:this={grainEl}\n\t\tclass={GRAIN}\n\t\tstyle:opacity={settings.opacity}\n\t\tstyle:mix-blend-mode={blend}\n\t\tstyle:background-size=\"{TILE * settings.size}px {TILE * settings.size}px\"\n\t></div>\n\t<canvas bind:this={dustEl} class={DUST}></canvas>\n\t{#if scanlines > 0}\n\t\t<div\n\t\t\tbind:this={linesEl}\n\t\t\tclass={LINES}\n\t\t\tstyle:opacity={clamp(scanlines, 0, 1)}\n\t\t\tstyle:mix-blend-mode={blend}\n\t\t></div>\n\t{/if}\n</div>\n"
